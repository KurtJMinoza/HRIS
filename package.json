{
  "scripts": {
    "pm2": "node ./scripts/pm2.cjs",
    "pm2:start": "node ./scripts/ensure-redis-windows.cjs && node ./scripts/pm2.cjs start ecosystem.config.cjs --update-env",
    "pm2:stop": "node ./scripts/pm2.cjs stop ecosystem.config.cjs",
    "pm2:restart": "node ./scripts/pm2-restart.cjs",
    "pm2:restart:all": "node ./scripts/pm2.cjs restart all",
    "pm2:delete": "node ./scripts/pm2.cjs delete ecosystem.config.cjs",
    "pm2:status": "node ./scripts/pm2.cjs status",
    "backup:run": "node ./scripts/backup-hris.cjs"
  },
  "devDependencies": {
    "pm2": "^7.1.1"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "playwright": "^1.58.2",
    "react-qr-reader": "^3.0.0-beta-1"
  }
}
