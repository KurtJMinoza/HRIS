# Copy to .env and adjust for your environment.

# If the production build is served from a subpath (e.g. http://localhost/HR/ or Laragon alias),
# set this so JS/CSS load correctly and routes match. Include leading and trailing slash.
# VITE_BASE=/HR/

# When the API is not at the Vite default proxy (127.0.0.1:8000), set the Laravel base URL:
# VITE_DEV_API_PROXY_TARGET=http://hr.test

# API base URL (see src/api.js). Default is same-origin /api.
# For CloudFront/Amplify Hosting, keep this as /api when CloudFront routes
# /api/* and /sanctum/* to the Laravel origin.
# If the API is on a separate host, set the full URL instead.
# VITE_API_URL=/api
# VITE_API_URL=http://127.0.0.1:8000/api

# Amazon Rekognition Face Liveness / Amplify UI. Keep these in the same region.
# Face Liveness is currently available only in us-east-1 and us-east-2.
# VITE_AWS_REGION=us-east-1
# VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Realtime notifications (Laravel Reverb/Pusher compatible). Must match backend broadcasting env.
# VITE_BROADCASTER=reverb
# VITE_REVERB_APP_KEY=local-key
# VITE_REVERB_HOST=127.0.0.1
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
